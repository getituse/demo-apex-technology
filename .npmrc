; Public npm registry, deliberately. Resolution here is fast (the local npm cache is warm)
; and it keeps package-lock.json portable, so Cloudflare Pages / Netlify / GitHub Actions
; work with no changes. Do NOT point this at the internal Artifactory host - that host does
; not resolve outside the corporate network and would break every CI build.
;
; Tarballs are 403 from this registry on the Broadridge network, so the DOWNLOAD step uses
; Artifactory via a command-line flag instead. See package.json scripts and
; docs/ENVIRONMENT.md section 5:
;   npm ci --registry=https://artifacts.devops.bfsaws.net/artifactory/api/npm/NPM/ \
;          --replace-registry-host=always
registry=https://registry.npmjs.org/

; The audit endpoint stalls badly on this network.
audit=false
fund=false

; Native archives take more than four minutes on the measured mirror connection.
fetch-timeout=900000
strict-ssl=true
